{
  "manifest_version": 2,
  "id": "geffnt.jmcomic-plugin",
  "version": "2.0.0",
  "name": "JMComic 漫画插件",
  "description": "基于 JMComic-Crawler-Python 的禁漫天堂漫画插件，支持漫画搜索、详情查询、章节下载，以及 PDF / 图片两种方式发送。",
  "author": {
    "name": "geffnt",
    "url": "https://github.com/geffnt"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/geffnt/jmcomic_plugin_for_maibot",
    "homepage": "https://github.com/geffnt/jmcomic_plugin_for_maibot"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jmcomic",
      "version_spec": ">=2.7.0"
    },
    {
      "type": "python_package",
      "name": "reportlab",
      "version_spec": ">=4.0.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "plugin_type": "integration",
  "capabilities": [
    "send.text",
    "send.image",
    "send.custom",
    "send.hybrid"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
